# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=

# App URLs
APP_BASE_URL=
NEXT_PUBLIC_APP_BASE_URL=

# Optional observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local server only. Do not copy this dev setting to Vercel Production/Preview.
# Vercel uses its server-provided VERCEL_ENV; production retains legacy keys.
REDIS_KEYSPACE=dev

# AI briefing (disabled; never use NEXT_PUBLIC_ for provider credentials)
AI_BRIEFING_ENABLED=false
# Set only after security/configuration review and explicit production approval.
AI_BRIEFING_PRODUCTION_VERIFIED=false
AI_BRIEFING_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Verified against official Anthropic docs; explicit model required when enabled.
AI_BRIEFING_MODEL=claude-haiku-5-5
AI_BRIEFING_CACHE_SECONDS=900
AI_BRIEFING_DAILY_ATTEMPTS=48
AI_BRIEFING_RETRY_SECONDS=30
AI_BRIEFING_USER_REQUESTS_PER_MINUTE=5
AI_BRIEFING_TIMEOUT_MS=20000
AI_BRIEFING_MAX_OUTPUT_TOKENS=1200
AI_BRIEFING_MAX_ARTICLES=12
AI_BRIEFING_MAX_ITEMS=5
AI_BRIEFING_MAX_INPUT_BYTES=12000
AI_BRIEFING_HEADLINE_CHARS=120
AI_BRIEFING_EXPLANATION_CHARS=400
# Separate approval gate for the standalone paid smoke test. Never set in CI.
AI_BRIEFING_LIVE_SMOKE_APPROVED=false

# Cron and newsletter
CRON_SECRET=
TEST_NEWSLETTER_EMAIL=
NEWSLETTER_MAILING_ADDRESS=

# Optional analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# Optional sponsor configuration
NEXT_PUBLIC_IN_FEED_SPONSOR_ENABLED=false

NEWSLETTER_TOP_SPONSOR_LABEL=
NEWSLETTER_TOP_SPONSOR_TITLE=
NEWSLETTER_TOP_SPONSOR_DESCRIPTION=
NEWSLETTER_TOP_SPONSOR_CTA_TEXT=
NEWSLETTER_TOP_SPONSOR_CTA_URL=

NEWSLETTER_MID_SPONSOR_LABEL=
NEWSLETTER_MID_SPONSOR_TITLE=
NEWSLETTER_MID_SPONSOR_DESCRIPTION=
NEWSLETTER_MID_SPONSOR_CTA_TEXT=
NEWSLETTER_MID_SPONSOR_CTA_URL=
